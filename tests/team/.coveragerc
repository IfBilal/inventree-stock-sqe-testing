[run]
source = ../../upstream/src/backend/InvenTree
include = */InvenTree/stock/*.py
          */InvenTree/InvenTree/fields.py
          */InvenTree/InvenTree/permissions.py
branch = True
relative_files = False
omit = */migrations/*, */tests*.py, */test_*.py, */fixtures/*
[report]
show_missing = True
